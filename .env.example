# Local SQLite file. Not a secret. Tests can override this with a temporary path.
HALO_DB_PATH=data/halo.db

# Optional. Used to sign invitation links. When unset, Halo uses a
# documented local fallback and says so on Circle. Set a unique value
# before sharing a server with anyone else. Do not commit a real secret.
# HALO_INVITE_SECRET=

# Optional. WebAuthn relying party. When unset, Halo uses the host of the
# incoming request, which is correct for local use at 127.0.0.1 or localhost.
# HALO_RP_ID=
# HALO_ORIGIN=
